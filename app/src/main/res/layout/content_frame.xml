                        <!--android:hint="@string/world_wide"-->
                        <!--android:textColor="@color/primaryText"-->
                        <!--android:textSize="@dimen/text_small"-->
                        <!--app:fonts="font_regular.ttf"-->
                        <!--android:visibility="gone"/>-->

                    <LinearLayout
                        android:id="@+id/iconLay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginEnd="5dp"
                        android:layout_centerVertical="true"
                        android:padding="5dp"
                        android:layout_alignParentRight="true">

                        <ImageView
                            android:id="@+id/cross_icon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center_vertical"
                            android:layout_toRightOf="@+id/autoCompleteTextView"
                            android:tint="@color/primaryText"
                            android:src="@drawable/cancel"
                            android:visibility="visible" />
                        <ImageView
                            android:id="@+id/downIcon1"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="5dp"
                            android:layout_marginStart="5dp"
                            android:layout_alignParentRight="true"
                            android:tint="@color/primaryText"
                            android:src="@drawable/down_arrow"
                            android:scaleY="-1"/>

                    </LinearLayout>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/locationListLay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/locationLay1"
                    android:visibility="visible">
                    <ListView
                        android:id="@+id/locationList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="always"/>
                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>




        <com.app.external.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|bottom"
            android:layout_margin="30dp"
            android:gravity="center"
            android:visibility="visible"
            android:id="@+id/btnAddStuff"
            app:fabColor="@color/colorPrimary"
            app:fabIcon="@drawable/cam_float"
            app:fabIconPosition="start"
            app:fabMenuGravity="center"
            app:fabMenuStyle="popRight"
            app:fonts="font_regular.ttf"
            app:fabSize="mini"
            app:fabText="@string/sell_your_stuff"
            app:fabTextColor="@color/white"
            app:fabType="circle"
            app:layout_anchor="@+id/collectionLay"
            app:layout_anchorGravity="bottom|center_horizontal"
            app:layout_behavior="com.app.external.FabScrollBehavior" />


    </android.support.design.widget.CoordinatorLayout>

    <LinearLayout
        android:id="@+id/left_drawer"
        android:layout_width="@dimen/slidingmenu_Behind_offset"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:layoutDirection="ltr"
        android:orientation="vertical">

        <include
            layout="@layout/menu_list"
            android:layout_width="@dimen/slidingmenu_Behind_offset"
            android:layout_height="match_parent" />
    </LinearLayout>
</android.support.v4.widget.DrawerLayout>