<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:id="@+id/profile_login"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:background="@drawable/s_before"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <com.app.external.CustomTextView
                android:id="@+id/notloged"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/your_not_logged"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@color/white"
                app:fonts="font_regular.ttf" />

            <com.app.external.CustomTextView
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/blue_round_corner"
                android:gravity="center"
                android:paddingBottom="5dp"
                android:paddingEnd="30dp"
                android:paddingStart="30dp"
                android:paddingTop="5dp"
                android:singleLine="true"
                android:text="@string/login"
                android:textAppearance="@android:style/TextAppearance.Medium"
                android:textColor="@color/white"
                app:fonts="font_regular.ttf" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="@drawable/s_before"
            android:orientation="vertical"
            android:padding="15dp"
            android:visibility="visible">

            <com.app.external.RoundedImageView
                android:id="@+id/userImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:background="@color/white"
                app:corner_radius="100dip"
                app:round_background="true" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|center_horizontal"
                android:layout_marginTop="7dp"
                android:orientation="vertical">

                <com.app.external.CustomTextView
                    android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="User name"
                    android:textAppearance="@android:style/TextAppearance.Large"
                    android:textColor="@color/white"
                    app:fonts="font_regular.ttf" />

                <com.app.external.CustomTextView
                    android:id="@+id/userId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/userName"
                    android:layout_centerHorizontal="true"
                    android:gravity="center_horizontal"
                    android:singleLine="true"
                    android:text="User Id"
                    android:textAppearance="@android:style/TextAppearance.Small"
                    android:textColor="@color/secondaryText"
                    android:textSize="15sp"
                    android:visibility="gone"
                    app:fonts="font_regular.ttf" />

                <RelativeLayout
                    android:id="@+id/reviewLay"
                    android:layout_width="235dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <RatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_centerHorizontal="true"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:rating="0"
                        android:scaleX=".4"
                        android:scaleY=".4"
                        android:theme="@style/RatingBar" />

                    <com.app.external.CustomTextView
                        android:id="@+id/ratingCount"
                        android:layout_width="33dp"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="30dp"
                        android:layout_marginTop="13dp"
                        android:text="(0)"
                        android:textAppearance="@android:style/TextAppearance.Small"
                        android:textColor="@color/white"
                        app:fonts="font_regular.ttf" />
                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/header"
        android:background="@color/white"
        android:divider="@null"
        android:dividerHeight="0dp"></ListView>

</LinearLayout>